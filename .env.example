# Google Gemini API (Wajib)
GEMINI_API_KEY=
# Opsional: override model utama (default: gemini-4-hydrogen)
GEMINI_MODEL=gemini-4-hydrogen

# Google Sheets (Wajib)
GOOGLE_SHEET_ID=1PZ024Tr8kONsIlKf68i2Y-YQLX3BFKhOmS3pvl2BRcc
# Bisa isi path ke file service-account.json ATAU string JSON utuh
GOOGLE_SERVICE_ACCOUNT_JSON=

# Telegram Bot (Wajib untuk terima draf X, saran komentar & notifikasi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Meta Threads API (Opsional di hari pertama; wajib untuk auto-post Threads)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Shopee Affiliate Open API (Opsional; untuk Auto Hunter saat antrean Sheets kosong)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Mode Uji Coba (true = tidak post ke Threads, hanya log + kirim draf ke Telegram)
DRY_RUN=true
